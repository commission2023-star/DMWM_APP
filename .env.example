# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais commiter .env

# --- Base de donnees ---
# WAMP en local : localhost, port 3306, utilisateur root, mot de passe vide.
# Aiven en production : renseigner l'hote, le port et les identifiants fournis.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dmwm_uasz
DB_USER=root
DB_PASSWORD=

# SSL : laisse vide pour l'automatique (active si DB_HOST n'est pas local).
# true force le SSL, false le desactive.
DB_SSL=

# --- Authentification ---
# Chaine aleatoire longue et unique. Ne jamais reutiliser celle de production.
JWT_SECRET=remplacer-par-une-chaine-aleatoire-longue

# --- Serveur ---
PORT=3000
